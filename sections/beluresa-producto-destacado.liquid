{% comment %}
  Beluresa Tools — Sección "Producto Destacado"
  Shopify OS 2.0 — galería de imágenes de marca + producto real de la tienda
  (selector de variantes, precio dinámico y botón de compra).
{% endcomment %}

{%- assign product = section.settings.product -%}
{%- assign gallery_blocks = section.blocks | where: "type", "gallery_image" -%}
{%- assign benefit_blocks = section.blocks | where: "type", "benefit" -%}
{%- assign badge_blocks = section.blocks | where: "type", "badge" -%}

<div
  class="beluresa-featured"
  style="--bf-bg:{{ section.settings.bg_color }};--bf-text:{{ section.settings.text_color }};--bf-accent:{{ section.settings.accent_color }};--bf-pt:{{ section.settings.padding_top }}px;--bf-pb:{{ section.settings.padding_bottom }}px;"
>
  <div class="beluresa-featured-container">
    {%- if product != blank -%}
      <div class="beluresa-featured-grid">

        <div class="beluresa-featured-gallery">
          <div class="beluresa-featured-gallery-main">
            {%- if gallery_blocks.size > 0 -%}
              {%- for block in gallery_blocks -%}
                {%- if block.settings.image -%}
                  <img
                    class="beluresa-gallery-img{% if forloop.first %} is-active{% endif %}"
                    data-beluresa-gallery-img
                    data-index="{{ forloop.index0 }}"
                    src="{{ block.settings.image | image_url: width: 1200 }}"
                    srcset="{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
                    sizes="(min-width: 750px) 50vw, 100vw"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    alt="{{ block.settings.image.alt | default: product.title | escape }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                {%- endif -%}
              {%- endfor -%}
            {%- elsif product.featured_image -%}
              <img
                class="beluresa-gallery-img is-active"
                src="{{ product.featured_image | image_url: width: 1200 }}"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                loading="eager"
              >
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'beluresa-gallery-img is-active beluresa-placeholder' }}
            {%- endif -%}
          </div>

          {%- if gallery_blocks.size > 1 -%}
            <div class="beluresa-featured-thumbs" role="tablist">
              {%- for block in gallery_blocks -%}
                {%- if block.settings.image -%}
                  <button
                    type="button"
                    class="beluresa-thumb{% if forloop.first %} is-active{% endif %}"
                    data-beluresa-thumb
                    data-index="{{ forloop.index0 }}"
                    aria-label="{{ 'Ver imagen' | escape }} {{ forloop.index }}"
                  >
                    <img src="{{ block.settings.image | image_url: width: 200 }}" width="80" height="80" alt="" loading="lazy">
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        <div class="beluresa-featured-info">
          {%- if section.settings.eyebrow != blank -%}
            <span class="beluresa-featured-eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}

          <h2 class="beluresa-featured-title">{{ section.settings.heading | default: product.title }}</h2>

          {%- if section.settings.show_rating and section.settings.rating_value > 0 -%}
            <div class="beluresa-featured-rating" aria-label="{{ section.settings.rating_value }} de 5">
              {%- for i in (1..5) -%}
                <span class="beluresa-star{% if i <= section.settings.rating_value %} is-filled{% endif %}">★</span>
              {%- endfor -%}
              {%- if section.settings.rating_count != blank -%}
                <span class="beluresa-rating-count">({{ section.settings.rating_count }})</span>
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="beluresa-featured-price">
            <span data-beluresa-price>{{ product.selected_or_first_available_variant.price | money }}</span>
            {%- if product.compare_at_price > product.price -%}
              <s class="beluresa-price-compare">{{ product.compare_at_price | money }}</s>
            {%- endif -%}
          </div>

          {%- if section.settings.subheading != blank -%}
            <div class="beluresa-featured-desc">{{ section.settings.subheading }}</div>
          {%- endif -%}

          {%- if benefit_blocks.size > 0 -%}
            <ul class="beluresa-featured-benefits">
              {%- for block in benefit_blocks -%}
                <li {{ block.shopify_attributes }}>
                  <span class="beluresa-benefit-icon" aria-hidden="true">{{ block.settings.icon }}</span>
                  {{ block.settings.text }}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- form 'product', product, class: 'beluresa-featured-form', data-beluresa-form: '' -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-beluresa-variant-id>

            {%- unless product.has_only_default_variant -%}
              {%- for option in product.options_with_values -%}
                <div class="beluresa-option">
                  <label class="beluresa-option-label" for="BeluresaOption-{{ section.id }}-{{ forloop.index0 }}">{{ option.name }}</label>
                  <select
                    id="BeluresaOption-{{ section.id }}-{{ forloop.index0 }}"
                    class="beluresa-option-select"
                    data-beluresa-option
                    data-index="{{ forloop.index0 }}"
                  >
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endfor -%}
            {%- endunless -%}

            <div class="beluresa-featured-actions">
              <button
                type="submit"
                class="beluresa-btn beluresa-btn--primary beluresa-add-to-cart"
                data-beluresa-submit
                data-add-text="{{ section.settings.cta_text | default: 'Añadir al carrito' | escape }}"
                {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}
              >
                <span data-beluresa-submit-text>
                  {%- if product.selected_or_first_available_variant.available -%}
                    {{ section.settings.cta_text | default: 'Añadir al carrito' }}
                  {%- else -%}
                    Agotado
                  {%- endif -%}
                </span>
              </button>
            </div>
          {%- endform -%}

          {%- if badge_blocks.size > 0 -%}
            <div class="beluresa-featured-badges">
              {%- for block in badge_blocks -%}
                <span class="beluresa-badge" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      <script type="application/json" data-beluresa-variants>
        {{ product.variants | json }}
      </script>
    {%- else -%}
      <div class="beluresa-featured-placeholder">
        <p>Selecciona un producto en la configuración de esta sección (panel lateral) para mostrar el producto destacado.</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .beluresa-featured {
    background-color: var(--bf-bg);
    color: var(--bf-text);
    padding-top: var(--bf-pt);
    padding-bottom: var(--bf-pb);
  }

  .beluresa-featured-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .beluresa-featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  /* Galería */
  .beluresa-featured-gallery-main {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: rgba(0, 0, 0, 0.05);
  }

  .beluresa-gallery-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .beluresa-gallery-img.is-active {
    opacity: 1;
    position: relative;
  }

  .beluresa-featured-thumbs {
    display: flex;
    gap: 10px;
    margin-top: 12px;
    overflow-x: auto;
  }

  .beluresa-thumb {
    flex: 0 0 auto;
    width: 64px;
    height: 64px;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid transparent;
    padding: 0;
    cursor: pointer;
    background: none;
    opacity: 0.6;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }

  .beluresa-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .beluresa-thumb.is-active {
    opacity: 1;
    border-color: var(--bf-accent);
  }

  /* Info */
  .beluresa-featured-eyebrow {
    display: block;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bf-accent);
    font-weight: 700;
    margin-bottom: 8px;
  }

  .beluresa-featured-title {
    font-size: clamp(24px, 4vw, 34px);
    line-height: 1.15;
    margin: 0 0 10px;
  }

  .beluresa-featured-rating {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-bottom: 12px;
  }

  .beluresa-star {
    color: rgba(0, 0, 0, 0.2);
    font-size: 16px;
  }

  .beluresa-star.is-filled {
    color: var(--bf-accent);
  }

  .beluresa-rating-count {
    margin-left: 6px;
    font-size: 13px;
    opacity: 0.7;
  }

  .beluresa-featured-price {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .beluresa-price-compare {
    margin-left: 8px;
    font-size: 16px;
    font-weight: 400;
    opacity: 0.5;
  }

  .beluresa-featured-desc {
    font-size: 15px;
    line-height: 1.6;
    opacity: 0.85;
    margin-bottom: 20px;
  }

  .beluresa-featured-desc p {
    margin: 0 0 10px;
  }

  .beluresa-featured-benefits {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .beluresa-featured-benefits li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
  }

  .beluresa-benefit-icon {
    flex: 0 0 auto;
  }

  /* Formulario */
  .beluresa-option {
    margin-bottom: 16px;
  }

  .beluresa-option-label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 6px;
  }

  .beluresa-option-select {
    width: 100%;
    max-width: 280px;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    background: #fff;
    font-size: 14px;
  }

  .beluresa-featured-actions {
    margin: 8px 0 20px;
  }

  .beluresa-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    border: 1.5px solid transparent;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
  }

  .beluresa-btn--primary {
    background: var(--bf-accent);
    color: #fff;
  }

  .beluresa-btn--primary:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.15);
  }

  .beluresa-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .beluresa-featured-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .beluresa-badge {
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.06);
  }

  .beluresa-featured-placeholder {
    padding: 60px 20px;
    text-align: center;
    opacity: 0.6;
  }

  @media screen and (min-width: 750px) {
    .beluresa-featured-grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 56px;
      align-items: start;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', function (event) {
    var thumb = event.target.closest('[data-beluresa-thumb]');
    if (!thumb) return;

    var gallery = thumb.closest('.beluresa-featured-gallery');
    if (!gallery) return;

    var index = thumb.getAttribute('data-index');

    gallery.querySelectorAll('[data-beluresa-gallery-img]').forEach(function (img) {
      img.classList.toggle('is-active', img.getAttribute('data-index') === index);
    });
    gallery.querySelectorAll('[data-beluresa-thumb]').forEach(function (btn) {
      btn.classList.toggle('is-active', btn === thumb);
    });
  });

  document.addEventListener('change', function (event) {
    var select = event.target.closest('[data-beluresa-option]');
    if (!select) return;

    var form = select.closest('[data-beluresa-form]');
    var wrapper = select.closest('.beluresa-featured');
    if (!form || !wrapper) return;

    var variantsScript = wrapper.querySelector('[data-beluresa-variants]');
    if (!variantsScript) return;

    var variants;
    try {
      variants = JSON.parse(variantsScript.textContent);
    } catch (e) {
      return;
    }

    var selectedOptions = [];
    form.querySelectorAll('[data-beluresa-option]').forEach(function (s) {
      selectedOptions[parseInt(s.getAttribute('data-index'), 10)] = s.value;
    });

    var matchedVariant = variants.filter(function (variant) {
      return selectedOptions.every(function (value, i) {
        return variant['option' + (i + 1)] === value;
      });
    })[0];

    var idInput = form.querySelector('[data-beluresa-variant-id]');
    var submitButton = form.querySelector('[data-beluresa-submit]');
    var submitText = form.querySelector('[data-beluresa-submit-text]');
    var priceEl = wrapper.querySelector('[data-beluresa-price]');

    if (matchedVariant) {
      idInput.value = matchedVariant.id;
      if (priceEl && matchedVariant.price != null) {
        priceEl.textContent = (matchedVariant.price / 100).toLocaleString('es-ES', {
          style: 'currency',
          currency: (window.Shopify && Shopify.currency && Shopify.currency.active) || 'EUR'
        });
      }
      if (matchedVariant.available) {
        submitButton.removeAttribute('disabled');
        if (submitText) submitText.textContent = submitButton.getAttribute('data-add-text');
      } else {
        submitButton.setAttribute('disabled', 'disabled');
        if (submitText) submitText.textContent = 'Agotado';
      }
    } else {
      idInput.value = '';
      submitButton.setAttribute('disabled', 'disabled');
      if (submitText) submitText.textContent = 'No disponible';
    }
  });
{% endjavascript %}

{% schema %}
{
  "name": "Beluresa: Producto destacado",
  "tag": "section",
  "class": "beluresa-featured-section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Producto",
      "info": "Selecciona el Rizador térmico de pestañas"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior (eyebrow)",
      "default": "BESTSELLER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título (vacío = usa el título del producto)"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Descripción corta",
      "default": "<p>El rizador térmico que abre tu mirada en 10 segundos y mantiene la curva hasta 24 horas.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Mostrar valoración",
      "default": true
    },
    {
      "type": "range",
      "id": "rating_value",
      "label": "Valoración (estrellas)",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "default": 4.5
    },
    {
      "type": "text",
      "id": "rating_count",
      "label": "Texto de nº de reseñas",
      "default": "1.284 reseñas"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texto del botón",
      "default": "Añadir al carrito"
    },
    {
      "type": "header",
      "content": "Colores y espaciado"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#FFF7F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto",
      "default": "#2B2320"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color de acento",
      "default": "#E5876E"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "gallery_image",
      "name": "Imagen de galería",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        }
      ]
    },
    {
      "type": "benefit",
      "name": "Beneficio",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icono (emoji)",
          "default": "✓"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Silicona antipellizcos hipoalergénica"
        }
      ]
    },
    {
      "type": "badge",
      "name": "Sello de confianza",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Envío en 24-48h"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Beluresa: Producto destacado",
      "blocks": [
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "benefit", "settings": { "icon": "🛡️", "text": "Calor seguro y controlado (60-80°C)" } },
        { "type": "benefit", "settings": { "icon": "🧴", "text": "Silicona antipellizcos hipoalergénica" } },
        { "type": "benefit", "settings": { "icon": "🔋", "text": "Carga USB-C, hasta 30 usos" } },
        { "type": "badge", "settings": { "text": "Envío en 24-48h" } },
        { "type": "badge", "settings": { "text": "Devolución 30 días" } }
      ]
    }
  ]
}
{% endschema %}
