{% comment %}
  Beluresa Beauty — Sección "Hero: HairDrop Pro"
  Shopify OS 2.0 — hero de portada para el producto estrella, totalmente configurable
  desde el Editor de Temas (textos, CTAs, imagen y colores).
{% endcomment %}

<div
  class="beluresa-hero"
  style="--bh-bg:{{ section.settings.bg_color }};--bh-text:{{ section.settings.text_color }};--bh-accent:{{ section.settings.accent_color }};--bh-accent-2:{{ section.settings.accent_color_2 }};--bh-pt:{{ section.settings.padding_top }}px;--bh-pb:{{ section.settings.padding_bottom }}px;"
>
  <div class="beluresa-hero-container">
    <div class="beluresa-hero-copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="beluresa-hero-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="beluresa-hero-heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="beluresa-hero-subheading">{{ section.settings.subheading }}</div>
      {%- endif -%}

      <div class="beluresa-hero-ctas">
        {%- if section.settings.primary_cta_text != blank -%}
          <a href="{{ section.settings.primary_cta_link | default: '#' }}" class="beluresa-btn beluresa-btn--primary">
            {{ section.settings.primary_cta_text }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_cta_text != blank -%}
          <a href="{{ section.settings.secondary_cta_link | default: '#' }}" class="beluresa-btn beluresa-btn--ghost">
            {{ section.settings.secondary_cta_text }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.trust_text != blank -%}
        <p class="beluresa-hero-trust">{{ section.settings.trust_text }}</p>
      {%- endif -%}
    </div>

    <div class="beluresa-hero-media">
      <div class="beluresa-hero-blob" aria-hidden="true"></div>
      <div class="beluresa-hero-render" data-beluresa-hero-render>
        {%- if section.settings.hero_image -%}
          <img
            class="beluresa-hero-img"
            src="{{ section.settings.hero_image | image_url: width: 1200 }}"
            srcset="{{ section.settings.hero_image | image_url: width: 600 }} 600w, {{ section.settings.hero_image | image_url: width: 900 }} 900w, {{ section.settings.hero_image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 750px) 45vw, 90vw"
            width="{{ section.settings.hero_image.width }}"
            height="{{ section.settings.hero_image.height }}"
            alt="{{ section.settings.hero_image.alt | default: section.settings.heading | escape }}"
            loading="eager"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'beluresa-hero-img beluresa-placeholder' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .beluresa-hero {
    background: linear-gradient(180deg, var(--bh-bg) 0%, #FBF8F4 100%);
    color: var(--bh-text);
    padding-top: var(--bh-pt);
    padding-bottom: var(--bh-pb);
    overflow: hidden;
  }

  .beluresa-hero-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  .beluresa-hero-eyebrow {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bh-accent);
    font-weight: 700;
    margin-bottom: 14px;
  }

  .beluresa-hero-heading {
    font-size: clamp(32px, 6vw, 56px);
    line-height: 1.08;
    margin: 0 0 18px;
    font-weight: 600;
  }

  .beluresa-hero-subheading {
    font-size: 17px;
    line-height: 1.6;
    max-width: 480px;
    opacity: 0.85;
    margin-bottom: 28px;
  }

  .beluresa-hero-subheading p {
    margin: 0;
  }

  .beluresa-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 18px;
  }

  .beluresa-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 34px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    border: 1.5px solid transparent;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
  }

  .beluresa-btn--primary {
    background: var(--bh-accent);
    color: #fff;
  }

  .beluresa-btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
  }

  .beluresa-btn--ghost {
    background: transparent;
    color: var(--bh-text);
    border-color: currentColor;
    opacity: 0.85;
  }

  .beluresa-btn--ghost:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .beluresa-hero-trust {
    font-size: 13px;
    letter-spacing: 0.02em;
    opacity: 0.7;
    margin: 0;
  }

  .beluresa-hero-media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 320px;
  }

  .beluresa-hero-blob {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 78%;
    height: 78%;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, var(--bh-accent-2), transparent 70%);
    opacity: 0.55;
    filter: blur(6px);
  }

  .beluresa-hero-render {
    position: relative;
    width: 82%;
    max-width: 420px;
    animation: beluresa-float 6s ease-in-out infinite;
    transform-style: preserve-3d;
  }

  .beluresa-hero-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 24px;
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.18));
  }

  .beluresa-placeholder {
    opacity: 0.35;
  }

  @keyframes beluresa-float {
    0%, 100% {
      transform: translateY(0) rotateZ(-1.5deg) rotateY(4deg);
    }
    50% {
      transform: translateY(-14px) rotateZ(1.5deg) rotateY(-4deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .beluresa-hero-render {
      animation: none;
    }
  }

  @media screen and (min-width: 750px) {
    .beluresa-hero-container {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 60px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Beluresa: Hero",
  "tag": "section",
  "class": "beluresa-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior (eyebrow)",
      "default": "HAIRDROP PRO™"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título (H1)",
      "default": "Cada gota, directo a la raíz."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "<p>HairDrop Pro™ transforma tu aceite o sérum capilar en un ritual de 2 minutos que nutre, masajea y estimula el crecimiento — sin desperdiciar ni una gota entre los dedos.</p>"
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Texto botón principal",
      "default": "Descubre HairDrop Pro →"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Enlace botón principal"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Texto botón secundario",
      "default": "Ver todos los accesorios"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Enlace botón secundario"
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Microcopy de confianza",
      "default": "⭐ 4.9/5 · Envío en 24–48h · Devolución gratuita 30 días"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Imagen / render del producto"
    },
    {
      "type": "header",
      "content": "Colores y espaciado"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#F4E1DE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto",
      "default": "#231F1C"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color de acento (botones)",
      "default": "#C9A46C"
    },
    {
      "type": "color",
      "id": "accent_color_2",
      "label": "Color del halo decorativo",
      "default": "#EFE6D8"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Beluresa: Hero"
    }
  ]
}
{% endschema %}
